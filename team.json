{
  "version": 1,
  "project": "../AfterDark",
  "poll_seconds": 15,
  "worker_timeout_seconds": 1200,
  "terminal_grace_seconds": 10,
  "stop_grace_seconds": 5,
  "max_fix_attempts": 2,
  "environment_max_attempts": 2,
  "max_calls_per_start": 100,
  "ux_interval_hours": 24,
  "ux_review_enabled": false,
  "operations_interval_seconds": 300,
  "operations_url": "https://sohbetavlusu.com/api/v1/ready",
  "auto_commit": true,
  "allow_push": true,
  "allow_deploy": true,
  "publish_min_interval_hours": 24,
  "skip_released_tasks": true,
  "continue_after_local_commit": true,
  "codex": "codex",
  "default_sandbox": "workspace-write",
  "execution_sandboxes": {
    "technical_lead": "danger-full-access",
    "environment_engineer": "danger-full-access",
    "qa": "danger-full-access",
    "developer": "danger-full-access"
  },
  "strategy_max_attempts": 2,
  "autonomous_intervention": true,
  "intervention_authorization": "owner-2026-10-19",
  "max_interventions_per_incident_hour": 10,
  "max_interventions_per_hour": 30,
  "publication_authorization": "owner-2026-10-18",
  "worker_inactivity_seconds": 600,
  "qa_owns_environment": true,
  "max_calls_per_delivery": 40,
  "archive_done_tasks": true,
  "archive_keep_log_entries": 8,
  "park_exhausted_tasks": true,
  "delivery_epoch": "focused-delivery-2026-10-18",
  "max_calls_per_release_recovery": 40,
  "engine_failover": true,
  "primary_engine": "codex",
  "role_engines": {
    "technical_lead": "claude",
    "code_reviewer": "claude"
  },
  "claude_binary": "claude",
  "claude_models": {
    "default": {
      "model": "claude-sonnet-5-5"
    }
  },
  "claude_quota_cooldown_seconds": 1800,
  "codex_probe_seconds": 300,
  "task_brief_limit_chars": 40000,
  "qa_tiers": {
    "enabled": true,
    "ui_paths": [
      "apps/web/"
    ],
    "suites": true,
    "check_timeout_seconds": 900,
    "shell": [
      "powershell",
      "-NoProfile",
      "-NonInteractive",
      "-Command"
    ],
    "source_checks": [
      {
        "id": "typecheck",
        "command": ". ./scripts/use-dev-tools.ps1; pnpm typecheck"
      },
      {
        "id": "lint",
        "command": ". ./scripts/use-dev-tools.ps1; pnpm lint"
      },
      {
        "id": "test",
        "command": ". ./scripts/use-dev-tools.ps1; pnpm test"
      }
    ],
    "preflight": {
      "tools": [
        "git"
      ],
      "files": [
        "scripts/use-dev-tools.ps1",
        "%APPDATA%/npm/corepack.cmd"
      ],
      "browser_paths": [
        "C:/Program Files/Google/Chrome/Application/chrome.exe",
        "C:/Program Files (x86)/Google/Chrome/Application/chrome.exe",
        "%LOCALAPPDATA%/Google/Chrome/Application/chrome.exe",
        "C:/Program Files (x86)/Microsoft/Edge/Application/msedge.exe",
        "C:/Program Files/Microsoft/Edge/Application/msedge.exe",
        ".tools/qa-browser"
      ],
      "ports_free": [
        3443
      ]
    }
  },
  "shared_context_sections": {
    "Product and identity": [
      "planner",
      "developer",
      "code_reviewer",
      "qa",
      "ux_reviewer",
      "technical_lead"
    ],
    "Work and evidence": [
      "planner",
      "developer",
      "code_reviewer",
      "qa",
      "ux_reviewer",
      "devops",
      "technical_lead",
      "environment_engineer"
    ],
    "Local environment and recovery": [
      "developer",
      "qa",
      "ux_reviewer",
      "environment_engineer",
      "technical_lead"
    ],
    "Local authority and current diagnostics": [
      "developer",
      "qa",
      "environment_engineer",
      "technical_lead"
    ],
    "Authorized delivery and resilience update": [
      "planner",
      "qa",
      "devops",
      "operations",
      "technical_lead"
    ],
    "Owner-authorized autonomous intervention": [
      "technical_lead"
    ]
  },
  "role_models": {
    "operations": {
      "model": "gpt-6-luna",
      "reasoning_effort": "low"
    },
    "devops": {
      "model": "gpt-6-luna",
      "reasoning_effort": "medium"
    },
    "planner": {
      "model": "gpt-6-sol",
      "reasoning_effort": "low"
    },
    "ux_reviewer": {
      "model": "gpt-6.1-sol",
      "reasoning_effort": "medium"
    },
    "qa": {
      "model": "gpt-6.1-sol",
      "reasoning_effort": "medium"
    },
    "environment_engineer": {
      "model": "gpt-6-sol",
      "reasoning_effort": "medium"
    },
    "developer": {
      "model": "gpt-6.1-sol",
      "reasoning_effort": "medium"
    },
    "code_reviewer": {
      "model": "gpt-6.1-sol",
      "reasoning_effort": "medium"
    },
    "technical_lead": {
      "model": "gpt-6.1-sol",
      "reasoning_effort": "medium"
    }
  },
  "release_diagnostic_model": {
    "model": "gpt-6.1-sol",
    "reasoning_effort": "medium"
  },
  "qa_acceptance_tasks": [
    "T103A",
    "T103B",
    "T103C",
    "T103D",
    "T103",
    "T138"
  ],
  "auto_batch_size": 1,
  "autonomous_discovery": {
    "enabled": true,
    "qa_exploration": true,
    "interval_minutes": 60,
    "max_interval_hours": 24
  },
  "self_improvement": {
    "enabled": true,
    "interval_hours": 12,
    "min_new_events": 30
  },
  "park_external_blockers": true,
  "park_retry_hours": 12,
  "max_interventions_per_incident": 3,
  "call_budget_cooldown_seconds": 1800,
  "delivery_batches": []
}