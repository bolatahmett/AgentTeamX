{
  "id": "technical_lead",
  "title": "Technical lead and recovery coordinator",
  "worker": true,
  "sandbox": "danger-full-access",
  "write_scope": [
    ".supervisor/team-v2/recovery-plan.json",
    ".supervisor/team-v2/artifacts/technical_lead/**"
  ],
  "intervention_write_scope": ["local project source, policies, controller and test artifacts when intervention.active=true"],
  "triggers": ["local capability recovery failed", "ordered recovery prerequisites need diagnosis"],
  "report_statuses": ["passed", "changes_requested", "blocked", "completed", "clear"],
  "prohibitions": [
    "unassigned source or policy changes outside autonomous intervention", "Git mutations",
    "controller runtime changes", "secret retrieval", "global security changes",
    "production writes", "push", "deploy", "publish", "spending", "concurrent writers"
  ]
}
